88,"lat":61.7309102,"lon":15.22163,"tags":{"access":"yes","amenity":"toilets","drinking_water":"no","fee":"no","toilets:disposal":"bucket","toilets:position":"seated","unisex":"yes","wheelchair":"no"}},{"type":"node","id":13415531881,"lat":61.7289722,"lon":15.3128493,"tags":{"access":"yes","amenity":"toilets","drinking_water":"no","fee":"no","toilets:disposal":"bucket","toilets:position":"seated","unisex":"yes","wheelchair":"no"}},{"type":"node","id":13415545398,"lat":61.7422394,"lon":15.1565516,"tags":{"access":"customers","amenity":"toilets","drinking_water":"yes","fee":"no","toilets:disposal":"flush","toilets:position":"seated","unisex":"yes","wheelchair":"yes"}},{"type":"node","id":13698747953,"lat":61.928956,"lon":15.5538718,"tags":{"highway":"rest_area"}},{"type":"node","id":14015626501,"lat":61.8002641,"lon":15.8420135,"tags":{"addr:housenumber":"121","addr:postcode":"82760","addr:street":"Härjedalsvägen","amenity":"cafe","check_date":"2026-07-14","contact:facebook":"100054268850614","contact:instagram":"kakfeen","name":"Kakfén","phone":"+46 651 210 60"}},{"type":"relation","id":304580,"center":{"lat":61.56212,"lon":15.210227},"tags":{"leisure":"nature_reserve","lst:aktuell":"2001-05-07","lst:anmärkning":"Beslutet 2000-11-01 avser omr. kring Hylströmmen, innebär även att skogsbruk förbjuds. Beslutet togs som en utvidgning av Voxnans NVO (se obj nr), övr delar har föreskrifter enligt det gamla NVO (skogsbruk tillåtet). Voxnans NVO beslutatades1990-06-18.","lst:area_ha":"774.73","lst:beskrivning":"Området består av södra norrlands största vattenfall. Omgivningarna täcks av gles tallskog, barrblandskog och strandkärr. Floran är artrik och bla fjällhällebräken förekommer. Hylströmmen hyser naturliga bestånd av harr och öring, även utter förekommer.","lst:följer_bestämmelsen":"Ja, förutom mellan Kringelströmmen och Storlungnet.","lst:lägesnoggrannhet":"Medelgod. Avståndet från stranden stämmer inte alltid exakt, liksom att vissa korvsjöar etc inte alltid stämmer med beslutskarta.","lst:metodbeskrivning":"Objektet erhållet från LM som digitaliserat efter analog beslutskarta. Området mellan Kringelströmmen och Storlungsströmmen är digitaliserat av LST och kombinerat med LM:s objekt.","lst:ref":"21-11-008","lst:syfte":"Att bevara ett större markområde omkring ett av södra Norrlands vackraste vattenfall med naturskogsartad hällmarkstallskog och våtmarker med dess biologiska mångfald. Att restaurera påverkade delar av området till förmån för strömfisken.","lst:sötvattensvärde":"yes","lst:tillkomst":"2000-11-01","name":"Voxnans NR","type":"multipolygon"}},{"type":"relation","id":7617009,"center":{"lat":61.5566158,"lon":15.1660722},"tags":{"leisure":"nature_reserve","lst:area_ha":"104.05","lst:ref":"2022809","lst:vatten_ha":"2.4","name":"Fräkentjärnarna","operator":"Länsstyrelsen i Dalarnas län","protect_class":"7","start_date":"2011-08-10","type":"multipolygon"}},{"type":"relation","id":7617010,"center":{"lat":61.578472,"lon":15.1495425},"tags":{"leisure":"nature_reserve","lst:area_ha":"64.31","lst:ref":"2022831","lst:vatten_ha":"0.33","name":"Tarveroxberget","operator":"Länsstyrelsen i Dalarnas län","protect_class":"1","start_date":"2011-08-10","type":"multipolygon"}},{"type":"relation","id":8475200,"center":{"lat":61.8771822,"lon":15.647878},"tags":{"AREA_HA":"1044.57","BESLSTATUS":"Gällande","FORVALTARE":"Länsstyrelsen i Gävleborgs län","IUCNKAT":"III, Naturmonument (Natural Monument)","KOMMUN":"Ljusdal","LAN":"Gävleborgs Län","LAND_HA":"616.35","NVRID":"2026210","OBJECTID":"29201718","SENGALLDAT":"2019-03-16","SKOG_HA":"546.86","SKYDDSTYP":"Naturreservat","URSBESLDAT":"2015-06-25","URSGALLDAT":"2015-07-18","VATTEN_HA":"428.22","leisure":"nature_reserve","name":"Mellanljusnans Naturreservat","type":"multipolygon","wikidata":"Q30170586"}},{"type":"relation","id":8476627,"center":{"lat":61.9433933,"lon":15.6293714},"tags":{"natural":"beach","type":"multipolygon"}},{"type":"relation","id":15620072,"center":{"lat":61.9913333,"lon":15.3802122},"tags":{"boundary":"protected_area","leisure":"nature_reserve","name":"Björkvallsbrännans naturreservat","operator":"Länsstyrelsen i Gävleborgs län","protect_class":"1a","protection_title":"Naturreservat","ref:NVRID":"2053002","ref:OBJECTID":"3293110","source":"Naturvårdsverket","start_date":"2022-06-11","type":"boundary","website":"https://www.lansstyrelsen.se/gavleborg/besoksmal/naturreservat/bjorkvallsbrannan.html"}},{"type":"relation","id":15771816,"center":{"lat":61.6159547,"lon":15.7071543},"tags":{"boundary":"protected_area","leisure":"nature_reserve","name":"Klimparnas naturreservat","operator":"Länsstyrelsen i Gävleborgs län","protect_class":"1a","protection_title":"Naturreservat","ref:DIARIENR":"511-5435-2011","ref:NVRID":"2052183","source":"Naturvårdsverket","start_date":"2022-01-01","type":"boundary","website":"https://www.lansstyrelsen.se/gavleborg/besoksmal/naturreservat/klimparna.html"}},{"type":"relation","id":17806324,"center":{"lat":61.7469235,"lon":15.7287915},"tags":{"natural":"beach","type":"multipolygon"}},{"type":"way","id":43248084,"center":{"lat":61.8562275,"lon":15.39084},"tags":{"leisure":"nature_reserve","lst:aktuell":"2006-08-03","lst:area_ha":"347.02","lst:beskrivning":"Risnosen utgör ett större intakt bergsområde med barrdominerad blandskog som bildat bestånd efter att den gamla grovskogen huggits bort och därefter påverkats i liten grad.","lst:lägesnoggrannhet":"Mycket god kvalitet","lst:metodbeskrivning":"Gränsen inmätt av LM","lst:ref":"21-02-118","lst:skogsvärde":"yes","lst:syfte":"Att bevara den biologiska mångfalden, vårda och bevara den värdefulla naturmiljön och tillgodose friluftslivet behov av områden","lst:tillkomst":"2006-06-21","lst:url":"http://www.x.lst.se/Naturreservat/ljusdal/Risnosen/","name":"Risnosens NR"}},{"type":"way","id":43248110,"center":{"lat":61.777607,"lon":15.974004},"tags":{"leisure":"nature_reserve","lst:aktuell":"2001-05-07","lst:area_ha":"3.71","lst:beskrivning":"Området är urskogsartat och består av en brandpräglad 150-400-årig tallskog samt granskog. Ett flertal sällsynta och hotade växter och djur förekommer.","lst:följer_bestämmelsen":"Nej","lst:metodbeskrivning":"Skärmdigitaliserat efter analog beslutskarta. Följer fastighetsgränser m m där det finns i gula kartan vektor från 1997. Saknas i gula kartan raster 1997. Finns ingen punkt som fixerar läget (typ skärning mellan två fastighetsgränser) därför är skärmdig","lst:ref":"21-02-085","lst:skogsvärde":"yes","lst:syfte":"Att bevara ett urskogsartat område med bla en 150-400-årig brandpräglad tallskog.","lst:tillkomst":"1999-01-07","name":"Kallmyrs NR"}},{"type":"way","id":43248111,"center":{"lat":61.589487,"lon":15.9888095},"tags":{"leisure":"nature_reserve","lst:aktuell":"2006-08-03","lst:area_ha":"8.70","lst:beskrivning":"Större nyckelbiotop. Högbonitetsskog","lst:lägesnoggrannhet":"Mycket god kvalitet","lst:metodbeskrivning":"Gränsen inmätt av LM","lst:ref":"21-02-127","lst:skogsvärde":"yes","lst:syfte":"Att bevara den biologiska mångfalden, vårda och bevara den värdefulla naturmiljön och tillgodose friluftslivet behov av områden","lst:tillkomst":"2006-06-21","lst:url":"http://www.x.lst.se/Naturreservat/ljusdal/Finnbrannan/","name":"Finnbrännans NR"}},{"type":"way","id":43248113,"center":{"lat":61.815452,"lon":15.9609615},"tags":{"leisure":"nature_reserve","lst:aktuell":"2001-05-07","lst:area_ha":"4.47","lst:beskrivning":"Området består av ett naturskogsområde med 150-200-åriga tallar i omgivningarna kring Djupbäckens utlopp i Ljusnan. Flera intressanta och sällsynta växter förekommer bla mosippa, bombmurkla och rikligt med knärot.","lst:följer_bestämmelsen":"Nej, saknas helt","lst:lägesnoggrannhet":"God kvalitet","lst:metodbeskrivning":"Följer exakt fastigheten som bildats i och med NR.","lst:ref":"21-02-080","lst:skogsvärde":"yes","lst:syfte":"Att bevara ett område med mer än 100-årig naturskogsartad barrskog för fri utveckling.","lst:tillkomst":"1996-12-10","name":"Djupbäckens NR"}},{"type":"way","id":43248114,"center":{"lat":61.657812,"lon":15.973914},"tags":{"leisure":"nature_reserve","lst:aktuell":"2001-05-07","lst:area_ha":"17.70","lst:beskrivning":"Området består av en källmyr och orörd granskog med inslag av björk, al och sälg. Skogen är urskogslik med en rik moss-, lav- och svampflora, varav flera hotade arter.","lst:följer_bestämmelsen":"Ja","lst:lägesnoggrannhet":"Mycket god kvalitet","lst:metodbeskrivning":"Kopierad från LM:s objekt efter att ha jämfört med analog beslutskarta. Följer också fastighetsgräns, strandlinje från gula kartan vektor 1997.","lst:ref":"21-02-052","lst:skogsvärde":"yes","lst:syfte":"Att skydda och bevara ett område med gammal naturskogsartad barrblandskog samt skogskärren i denna. Allt utgörande livsmiljöer för en rik, hotad och värdefull flora.","lst:tillkomst":"1995-05-10","name":"Bondarvsvallsbergets NR","wikidata":"Q30158306"}},{"type":"way","id":43248115,"center":{"lat":61.5543228,"lon":15.7021645},"tags":{"leisure":"nature_reserve","lst:aktuell":"2007-01-17","lst:area_ha":"91.92","lst:beskrivning":"Östsidan av Bursjöberget, naturskog","lst:lägesnoggrannhet":"Mycket god kvalitet","lst:metodbeskrivning":"Gränsen inmätt av LM","lst:ref":"21-02-130","lst:skogsvärde":"yes","lst:syfte":"Att bevara den biologiska mångfalden och att vårda och bevara den värdefulla naturmiljön i området och att tillgodose friluftslivets behov av områden.","lst:tillkomst":"2006-12-15","lst:url":"http://www.x.lst.se/Naturreservat/ovanaker/Bursjoberget/","name":"Bursjöbergets NR"}},{"type":"way","id":43248207,"center":{"lat":61.9434263,"lon":15.2634468},"tags":{"leisure":"nature_reserve","lst:aktuell":"2001-05-07","lst:area_ha":"280.61","lst:beskrivning":"Ån har en varierad miljö med känsliga biotoper som forsar, höljor, strandhällar, strandsnår, sand- och grusstränder. Goda stammar av harr och öring finns. Stränderna hyser en artrik flora med bla slakstarr, Kung Karls spira, getrams och fjällnejlika.","lst:friluftslivsvärden":"yes","lst:följer_bestämmelsen":"Ja","lst:geologiska_värden":"yes","lst:lägesnoggrannhet":"God","lst:metodbeskrivning":"Skärmdigitaliserad efter analog beslutskarta, med gula kartan raster från 1997 som stöd, efter att ha kollat att det stämmer med beslutskarta.","lst:ref":"21-11-010","lst:skogsvärde":"yes","lst:syfte":"Att bevara Ängraån, då den utgör en representativ skogså med vattenmiljö av stort hydrologisk, geologiskt och biologiskt värde. Att även bevara Ängraåns naturmiljö för turism och rörligt friluftsliv.","lst:sötvattensvärde":"yes","lst:tillkomst":"1995-03-10","name":"Ängraåns NVO","ref:NVRID":"2201496","website":"https://www.lansstyrelsen.se/gavleborg/om-oss/nyheter-och-press/nyheter/nyheter---gavleborg/2026-06-18-angeran-blir-nytt-naturreservat.html","wikidata":"Q142067054"}},{"type":"way","id":43248209,"center":{"lat":61.9011684,"lon":15.3836049},"tags":{"boundary":"protected_area","description":"Skogen utgörs av drygt 110-åriga bestånd som uppkommit efter skogsbränder. Granen dominerar i sluttningar och tallen höjdplatåer. I granskogen är lövinslaget bitvis stort med grova aspar och björkar. Mycket död ved finns som gynnar flora och fauna.","leisure":"nature_reserve","name":"Törnbergets naturreservat","operator":"Länsstyrelsen i Gävleborgs län","protect_class":"1a","protection_title":"Naturreservat","ref:DIARIENR":"6319-2018","ref:NVRID":"2001165","ref:lst":"21-02-089","short_name":"Törnberget","source":"Naturvårdsverket","start_date":"1999-09-01","website":"https://www.lansstyrelsen.se/gavleborg/besoksmal/naturreservat/tornberget.html","wikidata":"Q30208414"}},{"type":"way","id":43248210,"center":{"lat":61.8922435,"lon":15.348873},"tags":{"leisure":"nature_reserve","lst:aktuell":"2006-12-18","lst:area_ha":"47.21","lst:beskrivning":"Urskogsobjekt","lst:lägesnoggrannhet":"Mycket god kvalitet","lst:metodbeskrivning":"Gränsen inmätt av LM","lst:ref":"21-02-132","lst:skogsvärde":"yes","lst:syfte":"Att bevara den biologiska mångfalden och att vårda och bevara den värd